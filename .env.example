# --- Contraseñas de la infraestructura (docker compose) ---
KEYCLOAK_ADMIN_PASSWORD=cambia_esto
MSSQL_SA_PASSWORD=cambia_esto
GRAFANA_ADMIN_PASSWORD=cambia_esto
REPORTING_DB_PASSWORD=cambia_esto

# --- Base de datos ---
# Backend corriendo en local (uvicorn): SQL Server publicado en el puerto 1438
DATABASE_URL_DOCUMENTAL=
# Backend dentro de docker compose: usa el nombre del servicio y el puerto interno 1433
DATABASE_URL_DOCKER=

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=observabilidad-documental
KEYCLOAK_CLIENT_ID=sistema-documental-app
# Se usa en el backend y en la importación del realm
KEYCLOAK_CLIENT_SECRET=cambia_esto

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=backend-documental

# --- IA ---
# AI_PROVIDER: claude | ollama | none
AI_PROVIDER=ollama
# Respaldo opcional (por ejemplo ollama). Vacío = sin respaldo
AI_FALLBACK_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180