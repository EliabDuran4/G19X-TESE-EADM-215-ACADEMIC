#Variables de entorno
# Copie este archivo como backend/.env y complete los valores.

# KEYCLOAK

# URL del servidor de Keycloak
# Ejemplo: http://localhost:8080
KEYCLOAK_URL=
# Realm configurado 
KEYCLOAK_REALM=
# Client ID utilizado 
KEYCLOAK_CLIENT_ID=
# Client Secret del cliente de Keycloak
KEYCLOAK_CLIENT_SECRET=

# SQL SERVER

# Cadena de conexión a la base de datos SQL Server.
# Base de datos utilizada: observabilidad_documental
# Ejemplo de estructura:
# mssql+pyodbc://USUARIO:CONTRASENA@localhost:1438/observabilidad_documental?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Sustituya USUARIO y CONTRASENA por sus valores locales.
DATABASE_URL_DOCUMENTAL=

# ANTHROPIC / CLAUDE API

# API Key utilizada para el análisis documental mediante Claude.
# El sistema principal puede funcionar sin esta integración.
ANTHROPIC_API_KEY=