{
  "uid": "proceso-documental",
  "title": "Proceso documental",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Documentos por estado",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (documents_by_status_ratio)",
          "legendFormat": "{{status}}",
          "instant": true
        }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tiempo promedio hasta la decisión",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(document_decision_duration_seconds_sum) / sum(document_decision_duration_seconds_count)",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 de tiempo hasta la decisión",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(document_decision_duration_seconds_bucket[$__range])))",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Documentos subidos por categoría",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category) (increase(documents_uploaded_total[$__range]))",
          "legendFormat": "{{category}}",
          "instant": true
        }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Documentos por estado en el tiempo",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (documents_by_status_ratio)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Transiciones de estado",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from_status, to_status) (increase(document_status_transitions_total[5m]))",
          "legendFormat": "{{from_status}} → {{to_status}}"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Tiempo promedio de decisión por categoría",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category) (increase(document_decision_duration_seconds_sum[$__range])) / sum by (category) (increase(document_decision_duration_seconds_count[$__range]))",
          "legendFormat": "{{category}}",
          "instant": true
        }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "decimals": 1 }, "overrides": [] }
    }
  ]
}